<% content_for :message do %>
<%= t("mailer.general.greeting.informal.addressed_html", name: @admin.login) %>

<%= t(".created", app_name: ArchiveConfig.APP_SHORT_NAME, date: l(Time.current)) %>

<%= t(".invalidated") %>

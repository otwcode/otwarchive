<% mode = params[:show] == "to-read" ? "marked_for_later" : "history" %>

<!--Descriptive page name, messages and instructions-->
<h2 class="heading">
  <%= t(".#{mode}.page_heading") %>
</h2>
<!--/descriptions-->

<!--subnav-->
<% if @readings.present? %>
<ul class="navigation actions">
  <li>
    <%= span_if_current t(".history.navigation"), user_readings_path(@user), params[:show].blank? %>
  </li>
  <li>
    <%= span_if_current t(".marked_for_later.navigation"), user_readings_path(@user, show: "to-read"), params[:show] == "to-read" %>
  </li>
  <li>
    <%= link_to t(".clear_entire_history"), confirm_clear_user_readings_path(current_user) %>
  </li>
</ul>
<% end %>
<!--/subnav-->

<!--subnav-->
<%== pagy_nav @pagy %>
<!--/subnav-->

<!--main content-->
<h3 class="landmark heading">
  <%= t(".#{mode}.landmark") %>
</h3>
<% if @readings.present? %>
  <ol class="reading work index group">
    <% @readings.each do |reading| %>
      <%= render "reading_blurb", work: reading.work, reading: reading %>
    <% end %>
  </ol>
<% end %>
<!--/content-->

<!--subnav-->
<%== pagy_nav @pagy %>
<!--/subnav-->

<!--TAG ZONE: tagsets-->
<div class="tag tagset">
  <!--Descriptive page name and system messages, descriptions, and instructions.-->
  <h2 class="heading">
    <% if @user %>
      <%= t(".page_heading.user", user_name: @user.login) %> <%= link_to_help_modal(help_tag_sets_about_path, t(".tag_sets_about_help_title")) %>
    <% elsif @restriction %>
      <%= t(".page_heading.challenge") %>
    <% elsif @query %>
      <%= search_header @tag_sets, nil, t(".page_heading.query") %> <%= link_to_help_modal(help_tag_sets_about_path, t(".tag_sets_about_help_title")) %>
    <% else %>
      <%= t(".page_heading.default_html", help_modal_link: link_to_help_modal(help_tag_sets_about_path, t(".tag_sets_about_help_title")), archive_name: ArchiveConfig.APP_NAME) %>
    <% end %>
  </h2>
  <!--/descriptions-->

  <!--Subnavigation, sorting and actions-->
  <ul class="navigation actions">
    <li class="search">
      <%= form_tag tag_sets_path, class: "simple search", method: :get do |form| %>
        <fieldset>
          <%= text_field_tag "query", @query, title: t(".navigation.search.title") %>
          <%= submit_tag t(".navigation.search.submit") %>
        </fieldset>
      <% end %>
    </li>
    <% if logged_in? %>
      <li><%= link_to t(".navigation.new_tag_set"), new_tag_set_path %></li>
      <li><%= link_to t(".navigation.tags"), tags_path %></li>
    <% end %>
  </ul>
  <!--/subnav-->

  <!--main content-->
  <% if @tag_sets.empty? %>
    <p><%= t(".no_tag_sets_found") %></p>
  <% else %>
    <% if @tag_sets.respond_to?(:total_pages) %>
      <%= will_paginate @tag_sets %>
    <% end %>

    <h3 class="landmark heading"><%= t(".landmark") %></h3>
	  <ul class="index group">
      <% @tag_sets.each do |tag_set| %>
        <%= render 'tag_set_blurb', :tag_set => tag_set %>
      <% end %>
    </ul>

    <% if @tag_sets.respond_to?(:total_pages) %>
      <%= will_paginate @tag_sets %>
    <% end %>
  <% end %>
  <!--/content-->
</div>
<!--REVIEW: trying out articles on these fieldsets to see if that's a better chunker, but may revert after testing. Have also tossed in landmark headings on top level groups-->
<%= form_for(@work, html: { id: "work-form", class: "verbose post work" }) do |f| %>
  <p class="required notice">* <%= t("works.form.required_information") %></p>

  <%= render "work_form_tags", include_blank: false %>

  <fieldset class="preface" role="article">
    <legend><%= t("works.form.preface.legend") %></legend>
    <h3 class="landmark heading"><%= t("works.form.preface.legend") %></h3>
    <dl>
      <dt class="title required">
        <%= f.label :title, "#{t('works.form.preface.title.label')}*" %>
      </dt>
      <dd class="title required">
        <%= f.text_field :title, class: "observe_textlength text" %>
        <%= live_validation_for_field("work_title",
              maximum_length: ArchiveConfig.TITLE_MAX,
              minimum_length: ArchiveConfig.TITLE_MIN,
              failureMessage: t("works.form.preface.title.validation", count: ArchiveConfig.TITLE_MIN)) %>
        <%= generate_countdown_html("work_title", ArchiveConfig.TITLE_MAX) %>
      </dd>

      <!-- Add coauthors-->
      <%= render "pseuds/byline", form: f, object: @work %>

      <dt class="summary">
        <%= f.label :summary, t("works.form.preface.summary") %>
      </dt>
      <dd class="summary">
        <%= f.text_area :summary, class: "observe_textlength" %>
        <%= live_validation_for_field("work_summary", presence: false,
              maximum_length: ArchiveConfig.SUMMARY_MAX) %>
        <%= generate_countdown_html("work_summary", ArchiveConfig.SUMMARY_MAX) %>
      </dd>

      <!-- notes -->
      <%= render "notes_form", f: f, type: "work" %>

    </dl>
  </fieldset>

  <fieldset id="associations" role="article">
    <legend><%= t("works.form.associations.legend") %></legend>
    <h3 class="landmark heading"><%= t("works.form.associations.legend") %></h3>
    <dl>
      <% @assignments = get_open_assignments(current_user) %>
      <% if @assignments.any? || @work.challenge_assignments.any? %>
        <!-- if the user has open assignments? -->
        <dt class="collection">
          <%= f.label "challenge_assignment_ids[]", t("works.form.associations.fulfill_assignment") %>
          <%= link_to_help_modal(help_works_assignment_path, t("works.form.associations.works_assignment_help_title")) %>
        </dt>
        <dd class="collection listbox group">
          <h4 class="heading"><%= t("works.form.associations.open_assignments") %></h4>
          <%= checkbox_section f, :challenge_assignment_ids, (@work.challenge_assignments + @assignments).uniq,
                :checked_method => "challenge_assignments", :name_method => "title" %>
        </dd>
      <% end %>

      <% if !(@claims = current_user.request_claims.unstarted).empty? || !@work.challenge_claims.empty? %>
        <!-- if the user has open claims? -->
        <dt class="collection">
          <%= f.label "challenge_claim_ids[]", t("works.form.associations.fulfill_claim") %>
          <%= link_to_help_modal(help_works_assignment_path, t("works.form.associations.works_assignment_help_title")) %>
        </dt>
        <dd class="collection listbox group">
          <h4 class="heading"><%= t("works.form.associations.open_claims") %></h4>
          <%= checkbox_section f, :challenge_claim_ids, (@work.challenge_claims + @claims).uniq,
              :checked_method => "challenge_claims", :name_helper_method => "claim_title" %>
        </dd>
      <% end %>

      <!-- Add collection -->
      <dt class="collection">
        <%= f.label :collection_names, t("works.form.associations.post_to_collections") %>
        <%= link_to_help_modal(help_collectibles_add_to_collection_path, t("works.form.associations.collectibles_add_to_collection_help_title")) %>
      </dt>
      <dd class="collection">
        <%= f.text_field :collection_names, autocomplete_options("open_collection_names") %>
      </dd>

      <dt class="recipient">
        <%= f.label :recipients, t("works.form.associations.gift_to") %>
        <%= link_to_help_modal(help_works_recipients_path, t("works.form.associations.works_recipients_help_title")) %>
      </dt>
      <dd class="recipient">
        <%= f.text_field :recipients, autocomplete_options("pseud", value: @work.recipients(for_form = true)) %>
      </dd>

      <!-- Inspiration / remix -->
      <dt class="parent">
        <%= check_box_tag "parent-options-show", "1", check_parent_box(@work), class: "toggle_formfield" %>
      </dt>
      <dd class="parent">
        <%= label_tag "parent-options-show", t("works.form.works_parents.header") %>
        <%= link_to_help_modal(help_works_parents_path, t("works.form.works_parents.help_title")) %>

        <!-- Toggles on with parent checkbox -->
        <fieldset id="parent-options">
          <dl>
            <% new_parent, existing_parents = @work.parent_work_relationships.partition(&:new_record?) %>
            <% new_parent << @work.parent_work_relationships.build if new_parent.empty? %>

            <%= f.fields_for :parent_work_relationships, new_parent do |p| %>
              <dt><%= p.label :url, t("works.form.works_parents.url.label") %></dt>
              <dd>
                <%= p.text_field :url,
                      "aria-describedby" => "parent-attributes-url-field-description" %>
                <p class="important footnote" id="parent-attributes-url-field-description">
                  <%= t("works.form.works_parents.url.description") %>
                </p>
              </dd>

              <dt><%= p.label :title, t("works.form.works_parents.title") %></dt>
              <dd><%= p.text_field :title %></dd>

              <dt><%= p.label :author, t("works.form.works_parents.author") %></dt>
              <dd><%= p.text_field :author %></dd>

              <dt>
                <%= p.label :language_id, t("works.form.works_parents.language") %>
                <%= link_to_help_modal(help_works_languages_path, t("works.form.works_parents.language_help_title")) %>
              </dt>
              <dd>
                <%= p.select(:language_id, language_options_for_select(sorted_languages, "id"), prompt: " ") %>
              </dd>

              <dt class="translation"><%= p.check_box :translation %></dt>
              <dd class="translation">
                <%= p.label :translation, t("works.form.works_parents.translation") %>
                <%= link_to_help_modal(help_works_translation_link_path, t("works.form.works_parents.translation_link_help_title")) %>
              </dd>
            <% end %>

            <% unless existing_parents.blank? %>
              <dt><%= t("works.form.works_parents.current_parents") %></dt>
              <% existing_parents.each do |related_work| %>
                <dd>
                  <ul class="actions">
                    <li>
                      <% if related_work.parent %>
                        <% if related_work.parent.try(:unrevealed?) %>
                          <%= link_to t("works.form.works_parents.unrevealed_work"), related_work.parent %>
                        <% else %>
                          <%= link_to related_work.parent.title, related_work.parent %>
                        <% end %>
                      <% else %>
                        <%= t("works.form.works_parents.deleted_work") %>
                      <% end %>
                    </li>
                    <li>
                      <%= link_to t("works.form.works_parents.remove"), related_work, data: { confirm: t("works.form.works_parents.remove_confirm") }, method: :delete %>
                    </li>
                  </ul>
                </dd>
              <% end %>
            <% end %>
          </dl>
        </fieldset>
      </dd>

      <!-- Series checkbox (storyseriescheck) -->
      <!-- Checking this box causes the "manage series" dropdown to appear; unchecking it causes it to disappear. -->
      <dt class="serial">
        <%= check_box_tag "series-options-show", "1", check_series_box(@work), class: "toggle_formfield" %>
      </dt>
      <dd class="serial">
        <%= label_tag "series-options-show", t("works.form.associations.show_series_options") %>
        <%= link_to_help_modal(help_works_series_path, t("works.form.associations.works_series_help_title")) %>

        <!-- Toggles on with series checkbox -->
        <fieldset id="series-options">
          <dl>
            <%= fields_for "work[series_attributes]" do |s| %>
              <dt><%= s.label "id", t("works.form.associations.choose_series") %></dt>
              <dd>
                <%= s.collection_select(:id, @series, :id, :title, { selected: work_series_value(:id), prompt: true }) %>
              </dd>

              <dt><%= s.label :title, t("works.form.associations.create_new_series") %></dt>
              <dd><%= s.text_field :title, value: work_series_value(:title) %></dd>
            <% end %>

            <% unless @serial_works.blank? || @work.new_record? %>
              <dt><%= t("works.form.associations.current_series") %></dt>
              <% for serial in @serial_works %>
                <% unless serial.new_record? %>
                  <dd>
                    <ul class="actions" role="navigation">
                      <li>
                        <%= link_to serial.series.title, serial.series %>
                      </li>
                      <li>
                        <%= link_to t("works.form.associations.remove_from_series"), serial_work_path(serial), method: :delete %>
                      </li>
                    </ul>
                  </dd>
                <% end %>
              <% end %>
            <% end %>
          </dl>
        </fieldset>
      </dd>

      <%= fields_for "work[chapter_attributes]", @chapter do |c| %>
        <!-- Chaptered checkbox (work_is_wip) -->
        <!-- Checking this box causes the expected number of chapters box to appear; unchecking it causes it to disappear. -->
        <dt class="chaptered wip">
          <%= check_box_tag "chapters-options-show", "1", @work.chaptered?, class: "toggle_formfield" %>
        </dt>
        <dd class="chaptered wip">
          <%= label_tag "chapters-options-show", t("works.form.associations.show_chapters_options") %>

          <fieldset id="chapters-options">
            <dl>
              <dt><%= f.label :wip_length, t("works.form.associations.chapter_1_of") %></dt>
              <dd><%= f.text_field :wip_length, class: "number" %></dd>
              <dt><%= c.label :title, t("works.form.associations.chapter_title") %></dt>
              <dd><%= c.text_field :title, value: @chapter.title %></dd>
            </dl>
          </fieldset>
        </dd>

        <!--backdate-->
        <dt class="backdate">
          <%= f.check_box :backdate, { id: "backdate-options-show", class: "toggle_formfield" } %>
        </dt>
        <dd class="backdate">
          <%= label_tag "backdate-options-show", t("works.form.associations.show_publication_date_options") %>
          <%= link_to_help_modal(help_works_backdating_path, t("works.form.associations.works_backdating_help_title")) %>

          <fieldset id="backdate-options" class="optional">
            <dl>
              <dt><%= label_tag "published_at", t("works.form.associations.set_publication_date") %></dt>
              <dd id="managePublicationDate" class="datetime">
                <!--BACK END, this select box does not seem to be acquiring the label published_at -->
                <%= c.date_select("published_at", :start_year => Date.current.year, :end_year => 1950, :default => Date.current, :value => @chapter.published_at, :order => [:day, :month, :year]) %>
              </dd>
            </dl>
          </fieldset>
        </dd>

        <%= render "work_form_associations_language", f: f %>

        <dt class="skin">
          <%= f.label :work_skin_id, t("works.form.associations.select_skin") %>
          <%= link_to_help_modal(help_works_skins_path, t("works.form.associations.works_skins_help_title")) %>
        </dt>
        <dd class="skin">
          <%= f.collection_select :work_skin_id, all_coauthor_skins, :id, :title,
                { :selected => (@work.work_skin ? @work.work_skin.id.to_s : nil), include_blank: true } %>
          <p class="actions" role="navigation">
            <%= link_to t("works.form.associations.public_work_skins"), skins_path(skin_type: "WorkSkin") %>
          </p>
        </dd>
      </dl>

  </fieldset>

  <!-- privacy settings -->
  <fieldset class="privacy" role="article">
    <legend><%= t("works.form.privacy.legend") %></legend>
    <h3 class="landmark heading"><%= t("works.form.privacy.legend") %></h3>
    <dl>
      <!-- Privacy dropdown (storyprivacy) -->
      <dt class="restrict">
        <%= f.check_box :restricted %>
      </dt>

      <dd class="restrict">
        <%= f.label :restricted, t("works.form.privacy.visibility.restricted") %>
        <%= link_to_help_modal(help_privacy_restricted_work_path, t("works.form.privacy.visibility.help_title")) %>
      </dd>

      <dt class="moderated comments">
        <%= f.check_box :moderated_commenting_enabled %>
      </dt>
      <dd class="moderated comments">
        <%= f.label :moderated_commenting_enabled, t("comments.commentable.permissions.moderated_commenting.enable") %>
        <%= link_to_help_modal(help_privacy_moderated_commenting_path, t("comments.commentable.permissions.moderated_commenting.help_title")) %>
      </dd>

      <dt class="permissions comments">
        <%= t("comments.commentable.permissions.options.label") %>
        <%= link_to_help_modal(help_privacy_restricted_commenting_path, t("comments.commentable.permissions.options.help_title")) %>
      </dt>
      <dd class="permissions comments">
        <fieldset>
          <%=
            radio_button_list(f, :comment_permissions, [
              [:enable_all, t("comments.commentable.permissions.options.enable_all")],
              [:disable_anon, t("comments.commentable.permissions.options.disable_anon")],
              [:disable_all, t("comments.commentable.permissions.options.disable_all")]
            ])
          %>
        </fieldset>
      </dd>

    </dl>
  </fieldset>
  <% unless @chapters %>
    <!-- Work text field (chapter_attributes_content) -->
    <fieldset class="work text" role="article">
      <legend class="required"><%= t("works.form.content.legend") %>*</legend>
      <ul class="hidden rtf-html-switch actions" role="menu">
        <li><a class="rtf-link" href="#"><%= t("works.form.content.rich_text") %></a></li>
        <li><a class="html-link" href="#"><%= t("works.form.content.html") %></a></li>
      </ul>
      <p class="rtf-html-instructions note">
        <span class="html-notes"><%= allowed_html_instructions %></span>
        <span class="hidden rtf-notes"><%= rich_text_instructions %></span>
      </p>
      <p class="notice">
        <%= t("works.form.content.not_automatically_saved_html", not_automatically_saved_note_bold: tag.strong(t("works.form.content.not_automatically_saved_note")), not_automatically_saved_negation_bold: tag.strong(t("works.form.content.not_automatically_saved_negation"))) %>
      </p>

      <% use_tinymce %>
        <div class="rtf-html-field">
          <h4 class="landmark heading"><%= t("works.form.content.legend") %>*</h4>
          <%= c.text_area :content, value: @chapter.content,
                class: "mce-editor observe_textlength large", id: "content" %>
          <%= live_validation_for_field("content",
                maximum_length: ArchiveConfig.CONTENT_MAX_DISPLAYED,
                minimum_length: ArchiveConfig.CONTENT_MIN,
                tooLongMessage: t("works.form.content.validation.too_long", count: ArchiveConfig.CONTENT_MAX_DISPLAYED),
                tooShortMessage: t("works.form.content.validation.too_short", count: ArchiveConfig.CONTENT_MIN),
                failureMessage: t("works.form.content.validation.too_short", count: ArchiveConfig.CONTENT_MIN)) %>

          <%= generate_countdown_html("content", ArchiveConfig.CONTENT_MAX_DISPLAYED) %>
        </div>
      </fieldset>
    <% end %>

  <% end %><!-- end of fields for chapters -->

  <%= render "posting_fieldset" %>

<% end %> <!-- end of form_for -->

<%= content_for :footer_js do %>
  <%= javascript_tag do %>
    $j(document).ready(function(){
      $j(".toggle_formfield").click(function() {
        var targetId = $j(this).attr("id").replace("-show", "");
        toggleFormField(targetId);
      });
    })
  <% end %>
<% end %>
